# ============================================
# ACTIVE
# ============================================

# Ollama endpoint.
# Defaults to http://127.0.0.1:11434 when unset.
OLLAMA_URL=http://127.0.0.1:11434

# HomeLab Runtime Bridge.
# Optional absolute path to a public-safe report.
# Disabled unless set.
# Must never contain secrets, private hostnames, private IPs, usernames, or full transcripts.
HALO_RUNTIME_PUBLIC_SAFE_REPORT=

# Optional comma-separated deployment-specific identifiers that must never
# appear in Runtime Bridge report content.
# Keep real values only in local untracked environment configuration.
HALO_RUNTIME_PRIVATE_MARKERS=

# ============================================
# WEB SEARCH — disabled until configured
# ============================================

# Set to "searxng" to enable web search.
HALO_SEARCH_PROVIDER=

# SearXNG endpoint used only when HALO_SEARCH_PROVIDER=searxng.
HALO_SEARXNG_URL=
